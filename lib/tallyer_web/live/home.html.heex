<Layouts.app flash={@flash}>
  <div class="flex flex-col">
    <h2 class="text-xl text-center mb-4">Create a Game</h2>
    <button
      type="button"
      class="btn btn-primary h-auto"
      name="game_type"
      phx-click="create_game"
      value="scoreboard"
    >
      <div>
        <h3 class="text-lg text-center-py-1">
          Scoreboard
        </h3>
        <p class="">Track the scores of players/teams in a game</p>
      </div>
    </button>
  </div>
</Layouts.app>
