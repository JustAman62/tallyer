<Layouts.app flash={@flash}>
  <div class="flex flex-col max-w-2xl mx-auto gap-16">
    <div>
      <h2 class="text-xl text-center mb-4">Join Game</h2>
      <.form :let={f} for={%{}} phx-submit="join_game">
        <.input
          field={f[:game_id]}
          type="text"
          autocomplete="off"
          label="Game Code"
          required
          placeholder="ABCDEF"
        />
        <button type="submit" class="btn btn-primary w-full">Join</button>
      </.form>
    </div>

    <div>
      <h2 class="text-xl text-center mb-4">Create Game</h2>
      <button
        type="button"
        class="btn btn-accent h-auto w-full"
        name="game_type"
        phx-click="create_game"
        value="scoreboard"
      >
        <div>
          <h3 class="text-lg text-center-py-1">
            Scoreboard
          </h3>
          <p class="">Track the scores of players/teams in a game</p>
        </div>
      </button>
    </div>
  </div>
</Layouts.app>
